NODE_ENV=development
IP=localhost
PORT=3000

# Database (optional — uncomment if using TypeORM)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=my_service
# DB_USER=root
# DB_PASSWORD=
# DB_SYNCHRONIZE=true
# DB_LOG=false

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Admin access (toolkit) — JWT field and value for admin-level routes
SUPERUSER_FIELD=isSuperuser
SUPERUSER_VALUE=true

# Owner relation (toolkit) — default relation name linking entities to their owner
OWNER_TABLE=account

# Multi-tenancy (toolkit) — optional tenant scoping
# TENANT_TABLE=tenant          # relation path to tenant table (empty = single-tenant)
# TENANT_FIELD=id              # field on tenant table to match (default: id)

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=My Service API
SWAGGER_DESCRIPTION=Microservice built on api-server-toolkit
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
