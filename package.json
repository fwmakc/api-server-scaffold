{
  "name": "my-service",
  "version": "0.1.0",
  "description": "Microservice built on api-server-toolkit",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:fwmakc/scaffold"
  },
  "keywords": [
    "nestjs",
    "boilerplate",
    "template",
    "starter",
    "microservice"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/scaffold/issues"
  },
  "homepage": "https://github.com/fwmakc/scaffold#readme",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@sentry/nestjs": "^10.69.0",
    "api-server-toolkit": "github:fwmakc/api-server-toolkit#v0.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": { "^@src/(.*)$": "<rootDir>/$1" }
  }
}
